# Copy this to `.env` and fill in real values. `.env` is gitignored.
# In production, set these as platform env vars (Render / fly.io /
# Heroku UI) instead of using a .env file.

# ── Cloudflare R2: sign-bank video storage ────────────────────────
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXXXXXXXXXXXXXX.r2.dev
R2_BUCKET=signbridge-sign-bank

# Secret credentials -- only needed when running the migration
# upload script. The Flask runtime does NOT read these (browser
# fetches videos directly from R2_PUBLIC_BASE_URL).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Cloudflare REST API token (not used by sign-bank migration; keep
# only if you plan to manage Cloudflare resources programmatically).
CLOUDFLARE_API_TOKEN=

# ── Optional tuning ───────────────────────────────────────────────
# SIGNBRIDGE_MIN_CONFIDENCE=0.35
# SIGNBRIDGE_HOLISTIC_COMPLEXITY=1
