# Copy this to `.env` and fill in real values. `.env` is gitignored.
# In production, set these as platform env vars (Render / fly.io /
# Heroku UI) instead of using a .env file.

# ── Cloudflare R2: sign-bank video storage ────────────────────────
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXXXXXXXXXXXXXX.r2.dev
R2_BUCKET=signbridge-sign-bank

# Secret credentials. Needed by the sign-bank migration script AND by
# the data-capture feature, which WRITES user captures to R2 at runtime
# (capture_store.py). Without these, captures fall back to local disk
# (ephemeral on hosted Spaces -> lost on restart).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional: dedicated PRIVATE bucket for user captures so webcam clips
# don't share the public sign-bank bucket. Falls back to R2_BUCKET if
# unset. Recommended when captures contain real people's video.
R2_CAPTURES_BUCKET=signbridge-captures

# Cloudflare REST API token (not used by sign-bank migration; keep
# only if you plan to manage Cloudflare resources programmatically).
CLOUDFLARE_API_TOKEN=

# ── Optional tuning ───────────────────────────────────────────────
# SIGNBRIDGE_MIN_CONFIDENCE=0.35
# SIGNBRIDGE_HOLISTIC_COMPLEXITY=1
